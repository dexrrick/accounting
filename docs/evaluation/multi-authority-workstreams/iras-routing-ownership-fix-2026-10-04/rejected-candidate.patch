+function resolveIssueRoutingTopicIds(
+  issue: SemanticQuestionIssue,
+  mappedTopicIds: readonly string[],
+  inventoryIds: ReadonlySet<string>,
+  scopeTopicIds: readonly ReadonlySet<string>[]
+): string[] {
+  const mappedTopics = getCoverageTopicsByIds(mappedTopicIds);
+  const parentsById = new Map<string, ReturnType<typeof getCoverageTopicsByIds>[number]>();
+  for (const child of mappedTopics) {
+    for (const parentId of child.routingParentTopicIds || []) {
+      const parent = getCoverageTopicsByIds([parentId])[0];
+      if (!parent || !parent.routingOnly || parent.domainId !== child.domainId ||
+          !child.authorities.some(authority => parent.authorities.includes(authority) && issue.governingAuthorities.includes(authority as SemanticAuthority)) ||
+          !semanticAuthorityCoversTopic(issue.governingAuthorities, child.authorities, issue.domain) ||
+          !semanticAuthorityCoversTopic(issue.governingAuthorities, parent.authorities, issue.domain) ||
+          !inventoryIds.has(parent.id)) continue;
+      if (scopeTopicIds.some(scope => scope.has(child.id) && scope.has(parent.id)) &&
+          !scopeTopicIds.some(scope => isIndependentGenericParentScope(scope, parent))) {
+        parentsById.set(parent.id, parent);
+      }
+    }
+  }
+  return [...parentsById.keys()].sort();
+}
+
+function isIndependentGenericParentScope(
+  scopeTopicIds: ReadonlySet<string>,
+  parent: SingaporeCoverageTopic
+): boolean {
+  if (!scopeTopicIds.has(parent.id)) return false;
+  const sameParentChildren = getCoverageTopicsByIds([...scopeTopicIds]).filter(topic =>
+    topic.routingParentTopicIds?.includes(parent.id) && topic.domainId === parent.domainId &&
+    topic.authorities.some(authority => parent.authorities.includes(authority)));
+  return sameParentChildren.length === 0;
+}
+
+function removeUnownedRoutingParents(
+  issue: SemanticQuestionIssue,
+  mappedTopicIds: readonly string[],
+  routingTopicIds: readonly string[],
+  scopeTopicIds: readonly ReadonlySet<string>[]
+): string[] {
+  const mappedTopics = getCoverageTopicsByIds(mappedTopicIds);
+  const mappedIds = new Set(mappedTopicIds);
+  const subjectSpecificTopicIds = new Set(defaultQueryTopicResolver.decomposeQuery(issue.subject).topics
+    .map(topic => topic.id).filter(id => !getCoverageTopicsByIds([id])[0]?.routingOnly));
+  const unownedParents = mappedTopics.filter(topic => topic.routingOnly).filter(parent => {
+    const relatedMappedChild = mappedTopics.some(child => child.routingParentTopicIds?.includes(parent.id) &&
+      child.domainId === parent.domainId &&
+      child.authorities.some(authority => parent.authorities.includes(authority) && issue.governingAuthorities.includes(authority as SemanticAuthority)));
+    if (relatedMappedChild) {
+      return scopeTopicIds.some(scope => isIndependentGenericParentScope(scope, parent)) || !routingTopicIds.includes(parent.id);
+    }
+    // A routing parent can still be mapped as a generic issue on its own.
+    return subjectSpecificTopicIds.size > 0 || mappedTopics.some(topic => topic.id !== parent.id && mappedIds.has(topic.id));
+  });
+  const removeIds = new Set(unownedParents.map(topic => topic.id));
+  return mappedTopicIds.filter(id => !removeIds.has(id));
+}
