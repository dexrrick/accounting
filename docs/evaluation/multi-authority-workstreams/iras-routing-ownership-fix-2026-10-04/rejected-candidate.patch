+/** Raw request scopes used by reconciliation to keep unrelated asks separate. */
+export function getQueryScopeFragments(query: string): string[] {
+  if (!query || typeof query !== 'string') return [];
+  const normalizedQuery = query.toLowerCase();
+  const fragments = splitResidualFragments(normalizedQuery);
+  if (fragments.length === 0) return [normalizedQuery.trim()].filter(Boolean);
+
+  // splitResidualFragments focuses on unresolved suffixes after sentence
+  // boundaries. Include the initial request as a scope for ownership checks.
+  const primaryRequest = PRIMARY_REQUEST_START.exec(normalizedQuery);
+  if (primaryRequest) {
+    const firstTerminator = /[.!?;](?=\s|$)/g;
+    firstTerminator.lastIndex = (primaryRequest.index ?? 0) + primaryRequest[0].length;
+    const requestEnd = firstTerminator.exec(normalizedQuery);
+    if (requestEnd) fragments.push(normalizedQuery.slice(0, requestEnd.index).trim());
+  }
+  return [...new Set(fragments.map(fragment => fragment.trim()).filter(Boolean))];
+}
