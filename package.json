{
  "name": "accounting",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build_cloudflare_worker.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "preflight": "node scripts/preflight.mjs",
    "test": "npm run preflight && node scripts/run_all_tests.mjs --tier=full",
    "test:all": "npm run preflight && node scripts/run_all_tests.mjs --tier=full",
    "test:smoke": "npm run preflight && node scripts/run_all_tests.mjs --tier=smoke",
    "test:integration": "tsx tests/integration/test_real_source_integration.mjs",
    "test:official-source-live": "tsx scripts/validate_official_source_browser_path.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.5",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
