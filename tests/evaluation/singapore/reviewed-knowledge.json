    {
      "id": "acra-audit-exemption-missing-years",
      "provenance": "supervisor-authored-official-source",
      "question": "Our Singapore private company has current-year revenue of SGD 8 million and assets of SGD 9 million. We have not said whether it is newly incorporated or part of a group, or provided earlier-year figures. Does it qualify for the small-company audit exemption?",
      "reviewedOracle": {
        "review": { "status": "INDEPENDENTLY_VERIFIED", "reviewer": "independent-reviewer", "reviewedAt": "2026-09-25" },
        "claims": [{
          "id": "cannot-conclude",
          "conclusion": "Current-year revenue and assets alone do not establish audit exemption for an established company: the immediately preceding two financial years and any group-level qualification matter. For a newly incorporated company, the first-year rule differs.",
          "sources": [{ "recordId": "ACRA_SEC205C_SMALL_COMPANY_AUDIT_EXEMPTION", "officialSourceUrl": "https://www.acra.gov.sg/manage/companies/legal-requirements-common-offences/preparing-financial-statements/audit-exemptions/", "authority": "ACRA", "paragraphs": [] }],
          "assertions": [{ "path": "messageText", "op": "includesAny", "values": ["two consecutive financial years", "past two financial years"] }, { "path": "messageText", "op": "matches", "pattern": "(?:cannot|can't|insufficient|need more facts)[^\\n]{0,120}(?:conclud|determin|confirm|qualif)" }, { "path": "messageText", "op": "notMatches", "pattern": "(?:therefore|thus|conclusion:|your company|the company|it)[^\\n.]{0,60}qualif(?:y|ies) for (?:the )?(?:small-company )?audit exemption" }]
        }],
        "missingFacts": { "required": [
          { "id": "incorporation-age", "assertions": [{ "path": "messageText", "op": "includesAny", "values": ["newly incorporated", "first financial year", "established company"] }, { "path": "messageText", "op": "includesAny", "values": ["Please", "Could you", "confirm"] }] },
          { "id": "prior-years", "assertions": [{ "path": "messageText", "op": "includesAny", "values": ["two consecutive financial years", "past two financial years"] }, { "path": "messageText", "op": "includesAny", "values": ["Please", "Could you", "confirm"] }] },
          { "id": "group-status", "assertions": [{ "path": "messageText", "op": "includesAny", "values": ["group", "subsidiary"] }, { "path": "messageText", "op": "includesAny", "values": ["Please", "Could you", "confirm"] }] }
        ] },
        "citations": { "required": [{ "claimId": "cannot-conclude", "officialSourceUrl": "https://www.acra.gov.sg/manage/companies/legal-requirements-common-offences/preparing-financial-statements/audit-exemptions/" }] }
      }
