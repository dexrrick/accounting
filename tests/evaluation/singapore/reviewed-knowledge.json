          { "id": "cash-flow-terms", "assertions": [{ "path": "messageText", "op": "includesAny", "values": ["contractual cash flows", "principal and interest"] }, { "path": "messageText", "op": "includesAny", "values": ["Please", "Could you", "What are"] }] }
        ] },
        "calculation": { "forbidJournal": true },
        "citations": { "required": [{ "claimId": "cannot-classify-without-tests", "officialSourceUrl": "https://www.ifrs.org/issued-standards/list-of-standards/ifrs-9-financial-instruments/", "standard": "SFRS(I) 9" }, { "claimId": "cannot-classify-without-tests", "officialSourceUrl": "https://www.acra.gov.sg/regulations/accounting-standards-financial-reporting-surveillance/accounting-standards/" }] }
      }
