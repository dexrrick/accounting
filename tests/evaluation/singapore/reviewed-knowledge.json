    {
      "id": "sfrsi9-initial-costs",
      "provenance": "supervisor-authored-official-source",
      "question": "Under SFRS(I) 9, what is the initial carrying amount of a bond investment not measured at FVTPL or covered by the trade-receivable exception, if its fair value is SGD 100,000 and directly attributable acquisition transaction costs are SGD 2,000?",
      "reviewedOracle": {
        "review": { "status": "INDEPENDENTLY_VERIFIED", "reviewer": "independent-reviewer", "reviewedAt": "2026-09-25" },
        "claims": [{
          "id": "cost-capitalisation",
          "conclusion": "This bond investment outside FVTPL and the trade-receivable exception is initially measured at fair value plus directly attributable transaction costs; SGD 100,000 plus SGD 2,000 equals SGD 102,000. The facts do not establish a journal counterparty or settlement status.",
          "sources": [{ "recordId": "IFRS9_INITIAL_MEASUREMENT", "officialSourceUrl": "https://www.ifrs.org/issued-standards/list-of-standards/ifrs-9-financial-instruments/", "authority": "IFRS Foundation", "paragraphs": ["5.1.1"] }, { "officialSourceUrl": "https://www.acra.gov.sg/regulations/accounting-standards-financial-reporting-surveillance/accounting-standards/", "authority": "ACRA", "paragraphs": [] }],
          "assertions": [{ "path": "messageText", "op": "includesAny", "values": ["transaction costs", "acquisition costs"] }]
        }],
        "calculation": { "forbidJournal": true, "checks": [{ "path": "messageText", "op": "numberInText", "pattern": "(?:initial carrying amount|initial measurement|initial cost)[^\\n]{0,100}?SGD\\s*([\\d,]+(?:\\.\\d+)?)", "value": 102000, "tolerance": 0.01 }] },
        "citations": { "required": [{ "claimId": "cost-capitalisation", "officialSourceUrl": "https://www.ifrs.org/issued-standards/list-of-standards/ifrs-9-financial-instruments/", "standard": "SFRS(I) 9" }, { "claimId": "cost-capitalisation", "officialSourceUrl": "https://www.acra.gov.sg/regulations/accounting-standards-financial-reporting-surveillance/accounting-standards/" }] }
      }
    },
    {
      "id": "sfrsi9-amendment-effective-2025",
      "provenance": "supervisor-authored-official-source",
      "question": "For an annual reporting period beginning on 1 January 2025, are the ASC's 2024 amendments to SFRS(I) 9 and SFRS(I) 7 on classification and measurement already mandatorily effective?",
      "reviewedOracle": {
        "review": { "status": "INDEPENDENTLY_VERIFIED", "reviewer": "independent-reviewer", "reviewedAt": "2026-09-25" },
        "claims": [{
          "id": "effective-date",
          "conclusion": "The amendments announced by ASC in October 2024 are mandatory for annual reporting periods beginning on or after 1 January 2026; they are not mandatory for a period beginning 1 January 2025.",
          "sources": [{ "recordId": "SFRSI9_2026_CLASSIFICATION_AMENDMENTS", "officialSourceUrl": "https://www.acra.gov.sg/news-events/news-announcements/833/", "authority": "ACRA", "paragraphs": [] }],
          "assertions": [{ "path": "messageText", "op": "matches", "pattern": "(?:2025[^\\n]{0,120}(?:not mandatory|not yet mandatory|not required)|(?:not mandatory|not yet mandatory|not required)[^\\n]{0,120}2025)" }]
        }],
        "effectiveDate": { "assertions": [{ "path": "messageText", "op": "includes", "value": "1 January 2026" }, { "path": "messageText", "op": "includes", "value": "2025" }] },
        "citations": { "required": [{ "claimId": "effective-date", "officialSourceUrl": "https://www.acra.gov.sg/news-events/news-announcements/833/", "standard": "SFRS(I) 9" }] }
      }
    },
    {
      "id": "sfrsi9-equity-fvoci-election",
      "provenance": "supervisor-authored-official-source",
      "question": "Under SFRS(I) 9, we bought an equity investment in another company that is not held for trading and is not contingent consideration in an IFRS 3 business combination. At initial recognition we irrevocably elected to present subsequent fair value changes in OCI. On eventual sale, are the accumulated OCI gains recycled into profit or loss?",
      "reviewedOracle": {
        "review": { "status": "INDEPENDENTLY_VERIFIED", "reviewer": "independent-reviewer", "reviewedAt": "2026-09-25" },
        "claims": [{
          "id": "equity-no-recycling",
          "conclusion": "For an eligible non-trading equity investment with a valid irrevocable FVOCI election at initial recognition, subsequent fair value changes go to OCI and cumulative gains or losses are not recycled to profit or loss on disposal.",
          "sources": [{ "recordId": "IFRS9_EQUITY_CLASSIFICATION", "officialSourceUrl": "https://www.ifrs.org/content/dam/ifrs/publications/pdf-standards/english/2022/issued/part-a/ifrs-9-financial-instruments.pdf?bypass=on", "authority": "IFRS Foundation", "paragraphs": ["5.7.5", "B5.7.1"] }, { "officialSourceUrl": "https://www.acra.gov.sg/regulations/accounting-standards-financial-reporting-surveillance/accounting-standards/", "authority": "ACRA", "paragraphs": [] }],
          "assertions": [{ "path": "messageText", "op": "matches", "pattern": "(?:not|no)[^\\n]{0,80}(?:recycl|reclassif)[^\\n]{0,80}(?:profit or loss|P&L)" }]
        }],
        "citations": { "required": [{ "claimId": "equity-no-recycling", "officialSourceUrl": "https://www.ifrs.org/content/dam/ifrs/publications/pdf-standards/english/2022/issued/part-a/ifrs-9-financial-instruments.pdf?bypass=on", "standard": "SFRS(I) 9", "paragraphs": ["5.7.5", "B5.7.1"] }, { "claimId": "equity-no-recycling", "officialSourceUrl": "https://www.acra.gov.sg/regulations/accounting-standards-financial-reporting-surveillance/accounting-standards/" }] }
      }
    },
    {
      "id": "sfrsi9-ecl-12-month-no-amount",
      "provenance": "supervisor-authored-official-source",
      "question": "Under SFRS(I) 9, a bond measured at amortised cost was not purchased or originated credit-impaired and has not had a significant increase in credit risk since initial recognition. Should its loss allowance use 12-month or lifetime expected credit losses, and can you calculate the amount without exposure and probability or loss estimates?",
      "reviewedOracle": {
        "review": { "status": "INDEPENDENTLY_VERIFIED", "reviewer": "independent-reviewer", "reviewedAt": "2026-09-25" },
        "claims": [{
          "id": "ecl-horizon",
          "conclusion": "Under the general impairment approach for a non-POCI amortised-cost bond, absent a significant increase in credit risk, the loss allowance is measured at 12-month expected credit losses. The monetary amount cannot be calculated from the supplied facts because probability-weighted cash shortfalls and exposure estimates are missing.",
          "sources": [{ "recordId": "IFRS9_ECL_GENERAL", "officialSourceUrl": "https://www.ifrs.org/content/dam/ifrs/publications/pdf-standards/english/2022/issued/part-a/ifrs-9-financial-instruments.pdf?bypass=on", "authority": "IFRS Foundation", "paragraphs": ["5.5.5", "5.5.17"] }, { "officialSourceUrl": "https://www.acra.gov.sg/regulations/accounting-standards-financial-reporting-surveillance/accounting-standards/", "authority": "ACRA", "paragraphs": [] }],
          "assertions": [{ "path": "messageText", "op": "matches", "pattern": "12[- ]month[^\\n]{0,80}expected credit loss" }, { "path": "messageText", "op": "matches", "pattern": "(?:cannot|can't|insufficient)[^\\n]{0,100}(?:calculat|quantif|amount)" }]
        }],
        "missingFacts": { "required": [{ "id": "loss-estimates", "assertions": [{ "path": "messageText", "op": "includesAny", "values": ["exposure", "probability of default", "loss given default", "expected cash shortfalls"] }, { "path": "messageText", "op": "includesAny", "values": ["Please", "Could you", "provide"] }] }] },
        "calculation": { "forbidJournal": true },
        "citations": { "required": [{ "claimId": "ecl-horizon", "officialSourceUrl": "https://www.ifrs.org/content/dam/ifrs/publications/pdf-standards/english/2022/issued/part-a/ifrs-9-financial-instruments.pdf?bypass=on", "standard": "SFRS(I) 9", "paragraphs": ["5.5.5", "5.5.17"] }, { "claimId": "ecl-horizon", "officialSourceUrl": "https://www.acra.gov.sg/regulations/accounting-standards-financial-reporting-surveillance/accounting-standards/" }] }
      }
    },
    {
      "id": "iras-gst-standard-rate-2023",
      "provenance": "supervisor-authored-official-source",
      "question": "For a standard-rated Singapore supply with a GST-exclusive taxable value of SGD 1,000 made on 15 June 2023 with no transitional complication, what GST rate and output GST apply?",
      "reviewedOracle": {
        "review": { "status": "INDEPENDENTLY_VERIFIED", "reviewer": "independent-reviewer", "reviewedAt": "2026-09-25" },
        "sourceSelection": { "allowedRecordIds": ["GST_RATE_8_PERCENT_2023"] },
        "claims": [{
          "id": "historical-rate",
          "conclusion": "A standard-rated Singapore supply made on 15 June 2023 bears 8% GST, so output GST on SGD 1,000 is SGD 80.",
          "sources": [{ "recordId": "GST_RATE_8_PERCENT_2023", "officialSourceUrl": "https://www.iras.gov.sg/taxes/goods-services-tax-%28gst%29/basics-of-gst/current-gst-rates", "authority": "IRAS", "paragraphs": [] }],
          "assertions": [{ "path": "messageText", "op": "matches", "pattern": "15 June 2023,?[^.!?;,\\n]{0,100}8%[^.!?;,\\n]{0,100}SGD\\s*80(?:\\.00)?" }]
        }],
        "calculation": { "forbidJournal": true, "checks": [{ "path": "messageText", "op": "numberInText", "pattern": "15 June 2023,?[^.!?;,\\n]{0,100}8%[^.!?;,\\n]{0,100}SGD\\s*([\\d,]+(?:\\.\\d+)?)", "value": 80, "tolerance": 0.01 }] },
        "effectiveDate": { "assertions": [{ "path": "messageText", "op": "matches", "pattern": "15 June 2023,?[^.!?;,\\n]{0,100}8%" }] },
        "citations": { "required": [{ "claimId": "historical-rate", "officialSourceUrl": "https://www.iras.gov.sg/taxes/goods-services-tax-%28gst%29/basics-of-gst/current-gst-rates" }] }
      }
    },
