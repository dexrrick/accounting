    {
      "id": "sfrsi9-debt-hold-collect",
      "provenance": "supervisor-authored-official-source",
      "question": "Under SFRS(I) 9, our debt investment is managed solely to collect contractual cash flows, and its contractual terms provide only payments of principal and interest on specified dates. How is this financial asset measured subsequently?",
      "reviewedOracle": {
        "review": { "status": "INDEPENDENTLY_VERIFIED", "reviewer": "independent-reviewer", "reviewedAt": "2026-09-25" },
        "sourceSelection": { "forbiddenRecordIds": ["ACRA_VCC_STRUCTURE_AND_ONGOING_COMPLIANCE"] },
        "claims": [{
          "id": "classification",
          "conclusion": "A debt financial asset meeting both the hold-to-collect business-model condition and the solely-payments-of-principal-and-interest condition is measured at amortised cost, subject to any applicable fair-value designation exception.",
          "sources": [{ "recordId": "IFRS9_DEBT_CLASSIFICATION", "officialSourceUrl": "https://www.ifrs.org/issued-standards/list-of-standards/ifrs-9-financial-instruments/", "authority": "IFRS Foundation", "paragraphs": ["4.1.2"] }, { "officialSourceUrl": "https://www.acra.gov.sg/regulations/accounting-standards-financial-reporting-surveillance/accounting-standards/", "authority": "ACRA", "paragraphs": [] }],
          "assertions": [{ "path": "messageText", "op": "includes", "value": "amortised cost" }, { "path": "messageText", "op": "notMatches", "pattern": "(?:^|[.!?]\\s+)(?:(?:therefore|thus|but|however),?\\s+)?(?:this|the|our) (?:financial )?(?:asset|bond|investment)[^.!?\\n]{0,50}(?:classified as|measured at) (?:FVTPL|fair value through profit or loss)" }]
        }],
        "citations": { "required": [{ "claimId": "classification", "officialSourceUrl": "https://www.ifrs.org/issued-standards/list-of-standards/ifrs-9-financial-instruments/", "standard": "SFRS(I) 9" }, { "claimId": "classification", "officialSourceUrl": "https://www.acra.gov.sg/regulations/accounting-standards-financial-reporting-surveillance/accounting-standards/" }] }
      }
    },
    {
      "id": "sfrsi9-debt-collect-and-sell",
      "provenance": "supervisor-authored-official-source",
      "question": "Under SFRS(I) 9, our debt investment is managed both to collect contractual cash flows and to sell, and its contractual terms provide only payments of principal and interest on specified dates. How is this financial asset measured subsequently?",
      "reviewedOracle": {
        "review": { "status": "INDEPENDENTLY_VERIFIED", "reviewer": "independent-reviewer", "reviewedAt": "2026-09-25" },
        "claims": [{
          "id": "classification",
          "conclusion": "A debt financial asset satisfying the collect-and-sell business model and the solely-payments-of-principal-and-interest condition is measured at fair value through other comprehensive income, subject to applicable exceptions.",
          "sources": [{ "recordId": "IFRS9_DEBT_CLASSIFICATION", "officialSourceUrl": "https://www.ifrs.org/issued-standards/list-of-standards/ifrs-9-financial-instruments/", "authority": "IFRS Foundation", "paragraphs": ["4.1.2A"] }, { "officialSourceUrl": "https://www.acra.gov.sg/regulations/accounting-standards-financial-reporting-surveillance/accounting-standards/", "authority": "ACRA", "paragraphs": [] }],
          "assertions": [{ "path": "messageText", "op": "includesAny", "values": ["fair value through other comprehensive income", "FVOCI"] }, { "path": "messageText", "op": "notMatches", "pattern": "(?:^|[.!?]\\s+)(?:(?:therefore|thus|but|however),?\\s+)?(?:this|the|our) (?:financial )?(?:asset|bond|investment)[^.!?\\n]{0,50}(?:classified as|measured at) amortised cost" }]
        }],
        "citations": { "required": [{ "claimId": "classification", "officialSourceUrl": "https://www.ifrs.org/issued-standards/list-of-standards/ifrs-9-financial-instruments/", "standard": "SFRS(I) 9" }, { "claimId": "classification", "officialSourceUrl": "https://www.acra.gov.sg/regulations/accounting-standards-financial-reporting-surveillance/accounting-standards/" }] }
      }
    },
    {
      "id": "sfrsi9-bond-missing-facts",
      "provenance": "supervisor-authored-official-source",
      "question": "Under SFRS(I) 9, how should our bond investment be classified?",
      "reviewedOracle": {
        "review": { "status": "INDEPENDENTLY_VERIFIED", "reviewer": "independent-reviewer", "reviewedAt": "2026-09-25" },
        "claims": [{
          "id": "cannot-classify-without-tests",
          "conclusion": "The facts do not establish the business model or contractual cash-flow characteristics; a definitive amortised-cost, debt-FVOCI or FVTPL classification cannot be made.",
          "sources": [{ "recordId": "IFRS9_DEBT_CLASSIFICATION", "officialSourceUrl": "https://www.ifrs.org/issued-standards/list-of-standards/ifrs-9-financial-instruments/", "authority": "IFRS Foundation", "paragraphs": ["4.1.1"] }, { "officialSourceUrl": "https://www.acra.gov.sg/regulations/accounting-standards-financial-reporting-surveillance/accounting-standards/", "authority": "ACRA", "paragraphs": [] }],
          "assertions": [{ "path": "messageText", "op": "includes", "value": "business model" }, { "path": "messageText", "op": "includesAny", "values": ["contractual cash flows", "principal and interest"] }, { "path": "messageText", "op": "matches", "pattern": "(?:cannot|can't|insufficient|need more facts)[^\\n]{0,100}(?:classif|determin)" }, { "path": "messageText", "op": "notMatches", "pattern": "(?:^|[.!?]\\s+)(?:(?:therefore|thus|but|however),?\\s+)?(?:this|the|our) (?:financial )?(?:asset|bond|investment)[^.!?\\n]{0,50}(?:classified as|measured at) (?:amortised cost|FVOCI|FVTPL)" }]
        }],
        "missingFacts": { "required": [
